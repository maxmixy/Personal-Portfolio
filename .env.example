# Spotify app credentials: keep these server-side and do not use NEXT_PUBLIC_ prefixes.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/music/api/callback

# Neon/PostgreSQL connection used to persist encrypted owner tokens and public cache.
DATABASE_URL=

# Generate each as an independent long random secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_OWNER_KEY=
